---
import { site, nav } from '../site';
---

<header class="site-header">
  <a href="/" class="site-name">{site.name}</a>
  <nav class="site-nav" aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
