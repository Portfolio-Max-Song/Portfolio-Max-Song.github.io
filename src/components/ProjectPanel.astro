---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, date, skills, link } = project.data;
---

<article class="project">
  <header class="project-head">
    <h1 class="project-title" id="popup-title">
      {link ? <a href={link.href} target="_blank" rel="noopener">{title}</a> : title}
    </h1>
    <p class="project-date">{date}</p>
  </header>

  <div class="project-body">
    <Content />
  </div>

  <p class="project-skills"><strong>Skills: </strong>{skills.join(', ')}</p>

  {
    link && (
      <a href={link.href} class="website-button" target="_blank" rel="noopener">
        {link.label}
      </a>
    )
  }
</article>
