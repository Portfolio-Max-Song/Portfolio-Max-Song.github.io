---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import OrgMark from '../components/OrgMark.astro';
import ProjectPopup from '../components/ProjectPopup.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site, socials, orgs } from '../site';
import headshot from '../assets/images/headshot.jpg';

// Each row opens its project's popup. `slug` is the project's folder name.
const lists = [
  {
    heading: 'Internships & Organizations',
    rows: [
      { slug: 'contoro', icon: 'contoro', name: 'Contoro Robotics', category: 'Test Fixtures, Controls & Manufacturing', year: '2026' },
      { slug: 'trel', icon: 'trel', name: 'Texas Rocket Engineering Lab', category: 'Composites & Structures', year: '2025' },
    ],
  },
  {
    heading: 'Projects',
    rows: [
      { slug: 'song-leather', icon: 'leather', name: 'Song Leather', category: 'Product Design & Leatherworking', year: '2020' },
      { slug: 'macropad', icon: 'macropad', name: 'The Macropad', category: 'CAD, Printing & Soldering', year: '2024' },
      { slug: 'record-player', icon: 'record', name: 'The RFID Record Player', category: 'Electronics & 3D Printing', year: '2021' },
    ],
  },
] as const;
---

<Base title={site.name}>
  <main class="page">
    <div class="hero">
      <div>
        <h1 class="hero-title">{site.name}</h1>
        <p class="hero-tagline">{site.tagline}</p>
        <div class="hero-links">
          <a href="#contact">Contact</a>
          <a href="/about.html">About</a>
          <a href="/projects.html">Projects</a>
          <a href={site.resume} target="_blank" rel="noopener">Resume</a>
        </div>
      </div>
      <Image src={headshot} alt="Max Song" class="hero-photo" width={840} />
    </div>

    <div class="intro">
      <p>
        Currently a fourth-year mechanical engineering student at the University of
        Texas at Austin. Previously worked at <a href={orgs.contoro} target="_blank" rel="noopener"
          ><OrgMark name="contoro" />Contoro Robotics</a
        > as a robotics engineering intern, creating test fixtures and streamlining the manufacturing process. At university, I work at <a
          href={orgs.inventionworks}
          target="_blank"
          rel="noopener"><OrgMark name="tiw" />Texas Inventionworks (TIW)</a
        >, the campus makerspace, and was part of the <a href={orgs.trel} target="_blank" rel="noopener"
          ><OrgMark name="trel" />Texas Rocket Engineering Lab (TREL)</a
        >.
      </p>
      <p>I enjoy making simple, useful, and repeatable things that get used.</p>
    </div>

    {
      lists.map((list) => (
        <section class="home-section">
          <h2 class="section-label">
            <a href="/projects.html">{list.heading}</a>
          </h2>
          <div class="home-rows" data-home-rows>
            {list.rows.map((row) => (
              <a href={`/projects/${row.slug}.html`} class="home-row">
                <span class="home-row-icon">
                  <OrgMark name={row.icon} />
                </span>
                <span class="home-row-name">{row.name}</span>
                <span class="home-row-category">{row.category}</span>
                <span class="home-row-year">{row.year}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section id="contact" class="contact">
      <h2>Contact</h2>
      <ul class="contact-links">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                {...(s.href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' })}
              >
                <SocialIcon name={s.icon} />
                <span>{s.href.startsWith('mailto:') ? site.email : s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <ProjectPopup />
</Base>

<script>
  // Hovering a row lifts it and dims the rest of its list. Driven from the
  // rows rather than :hover, so crossing the gap between two rows doesn't
  // flash the whole list back to full strength.
  for (const list of document.querySelectorAll<HTMLElement>('[data-home-rows]')) {
    const rows = [...list.children] as HTMLElement[];
    for (const row of rows) {
      row.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        for (const other of rows) {
          other.classList.toggle('is-active', other === row);
          other.classList.toggle('is-dimmed', other !== row);
        }
      });
    }
    list.addEventListener('pointerleave', () => {
      for (const row of rows) row.classList.remove('is-active', 'is-dimmed');
    });
  }
</script>
