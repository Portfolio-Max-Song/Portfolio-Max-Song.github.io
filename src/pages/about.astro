---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { orgs } from '../site';
import lifeArgon from '../assets/images/social/argon.jpg';
import lifeCarnitas from '../assets/images/social/carnitas.jpg';
import lifeDinner from '../assets/images/social/dinner.jpg';
import lifeDog from '../assets/images/social/dog.jpg';
import lifeGolf from '../assets/images/social/golf.jpg';
import lifePaintball from '../assets/images/social/paintball.jpg';

// Drop more files into src/assets/images/social/ and add them here — the grid
// is three across, so nine photos fills it out evenly.
const lifePhotos = [
  { src: lifeGolf, alt: 'Out golfing' },
  { src: lifePaintball, alt: 'Playing paintball' },
  { src: lifeDog, alt: 'My dog' },
  { src: lifeCarnitas, alt: 'Trying carnitas around Austin' },
  { src: lifeArgon, alt: 'Out with friends' },
  { src: lifeDinner, alt: 'Dinner with friends' },
];
---

<Base
  title="About"
  description="About Max Song — mechanical engineering student at UT Austin, previously a robotics engineering intern at Contoro Robotics."
>
  <div class="page">
    <div class="page-head">
      <h1>About</h1>
    </div>

    <div class="about-body">
      <p>
        I'm Max, an engineer and designer drawn to practical, aesthetic design, with a
        love for minimalism. I'm studying mechanical engineering at the University of
        Texas at Austin.
      </p>

      <p>
        Right now I work at <a href={orgs.inventionworks} target="_blank" rel="noopener"
          >Texas Inventionworks</a
        >, the campus makerspace, where I lead the woodshop and teach on the machine shop
        team. Previously I worked at <a href={orgs.contoro} target="_blank" rel="noopener"
          >Contoro Robotics</a
        > as a robotics engineering intern, creating test fixtures and streamlining the
        manufacturing process, and I was part of the <a
          href={orgs.trel}
          target="_blank"
          rel="noopener">Texas Rocket Engineering Lab</a
        >.
      </p>

      <p>
        On the side, I still make things for people. <a
          href={orgs.songLeather}
          target="_blank"
          rel="noopener">Song Leather</a
        > started in high school as a small leather goods business and these days mostly runs
        as gifts for friends and family. I design <a href="/projects/personal.html"
          >small everyday objects</a
        > when something around my apartment annoys me enough — a phone case, a desk lamp, a
        shoe rack that cost $9.09 to build. And I play volleyball with UT's men's club team.
      </p>

      <p>Thanks for reading about me. Feel free to message me — I'd love to talk!</p>
    </div>

    <div class="photo-grid">
      {
        lifePhotos.map((photo) => (
          <Image
            src={photo.src}
            alt={photo.alt}
            class="photo-grid-item"
            width={480}
            height={480}
            loading="lazy"
          />
        ))
      }
    </div>
  </div>
</Base>
