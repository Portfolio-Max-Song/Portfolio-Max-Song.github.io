---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, date, description, skills, hero, gallery, link } =
  project.data;

// Referencing hero.src directly would point at the untouched original, which
// forces Astro to emit the full-size file into the build. A purpose-made
// 1200x630 derivative is both the right shape for link previews and far smaller.
// Pages written before their photos arrive have no hero, and so no OG image.
const og = hero
  ? await getImage({
      src: hero,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
    })
  : undefined;
---

<Base title={title} description={description} ogImage={og?.src}>
  <div id="top" class="project-banner">
    <div class="project-title-section">
      <h1>{title}</h1>
      <p class="project-meta">
        {/* Just the dates: the org is the <h1> above, and the role lives on
            the projects index card. */}
        <span>{date}</span>
      </p>
      <div class="title-underline"></div>
    </div>

    <div class="project-body">
      {/* `hero` still feeds the index card thumbnail and the link-preview
          image; it is no longer repeated at the top of the page itself. */}
      <Content />
    </div>

    <p class="section-description project-skills">
      Skills: {skills.join(', ')}
    </p>

    {
      gallery.length > 0 && (
        <div class="carousel-section">
          <div class="carousel-container">
            {gallery.map((item) => (
              <div class="carousel-item">
                <Image
                  src={item.src}
                  alt={item.alt}
                  class="carousel-image"
                  width={600}
                  height={600}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      link && (
        <a href={link.href} class="website-button" target="_blank" rel="noopener">
          {link.label}
        </a>
      )
    }

    <a href="/projects.html" class="back-link">Back to Projects</a>
  </div>
</Base>

<script>
  // Steps each page carousel by one page per click, clamped so the last
  // page lands at the right edge rather than leaving empty space.
  for (const carousel of document.querySelectorAll<HTMLElement>('.page-carousel')) {
    const track = carousel.querySelector<HTMLElement>('.page-carousel-track');
    const prev = carousel.querySelector<HTMLButtonElement>('.page-carousel-button.is-prev');
    const next = carousel.querySelector<HTMLButtonElement>('.page-carousel-button.is-next');
    if (!track || !prev || !next) continue;
    const items = [...track.children] as HTMLElement[];
    let index = 0;

    const update = () => {
      const perView = Number(getComputedStyle(carousel).getPropertyValue('--per-view')) || 1;
      const last = Math.max(0, items.length - perView);
      index = Math.min(Math.max(index, 0), last);
      const offset = items[index] ? items[index].offsetLeft - items[0].offsetLeft : 0;
      track.style.transform = `translateX(${-offset}px)`;
      prev.disabled = index === 0;
      next.disabled = index === last;
    };

    prev.addEventListener('click', () => { index -= 1; update(); });
    next.addEventListener('click', () => { index += 1; update(); });
    window.addEventListener('resize', update);
    update();
  }
</script>
