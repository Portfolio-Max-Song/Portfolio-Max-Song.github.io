---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import ProjectPanel from '../../components/ProjectPanel.astro';
import ProjectPopup from '../../components/ProjectPopup.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, hero } = project.data;

// Referencing hero.src directly would point at the untouched original, which
// forces Astro to emit the full-size file into the build. A purpose-made
// 1200x630 derivative is both the right shape for link previews and far smaller.
// Pages written before their photos arrive have no hero, and so no OG image.
const og = hero
  ? await getImage({
      src: hero,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
    })
  : undefined;
---

<Base title={title} description={description} ogImage={og?.src}>
  {/* A project's page is the projects grid with that project's popup open
      over it, so closing the popup leaves the visitor on the grid. The popup
      on every other page fetches this page and lifts out the panel. */}
  <main class="page">
    <h1 class="page-title">Projects</h1>
    <ProjectGrid />
  </main>

  <ProjectPopup open closeTo={{ url: '/projects.html', title: `Projects — ${site.name}` }}>
    <ProjectPanel project={project} />
  </ProjectPopup>
</Base>
